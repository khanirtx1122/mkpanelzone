generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id                String           @id @default(uuid())
  identifier        String           @unique
  passwordHash      String
  platformType      String           @default("ANDROID")
  branchId          String?
  packageId         String?
  status            String           @default("active")
  createdSource     String           @default("MIGRATED")
  createdByAgentId  String?
  agentPaymentProof String?
  lastLoginAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  agent             Agent?           @relation(fields: [createdByAgentId], references: [id])
  package           Package?         @relation(fields: [packageId], references: [id])
  branch            PlatformBranch?  @relation(fields: [branchId], references: [id])
  devices           CustomerDevice[]

  // Hot admin list paths: platform filter + newest-first ordering.
  @@index([platformType, createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([createdByAgentId])
  @@index([packageId])
}

/// The single source of truth for access platforms (ANDROID, IPHONE, PC, ...).
/// `code` is the stable, immutable key referenced by customers, branches,
/// packages and resources. `code` is never shown to end users; `name` is.
/// Owner can add new platforms from the Admin panel — no code change needed.
model Platform {
  id          String   @id @default(uuid())
  /// Stable uppercase key, e.g. ANDROID | IOS | PC | FANCY. Immutable once created.
  code        String   @unique
  /// Display name shown publicly, e.g. "Android", "iPhone", "Fancy".
  name        String
  description String?
  /// Controlled icon key resolved by the UI (never raw markup).
  iconKey     String   @default("layers")
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isEnabled, sortOrder])
}

/// Generic per-platform access branch (e.g. ANDROID → AIM Plus Holo, HEXHEAD).
/// Customers and resources point at a branch; null branchId means the
/// platform-wide legacy experience (no branch split). Architecture supports
/// any number of branches on any platform without further redesign.
model PlatformBranch {
  id                 String   @id @default(uuid())
  platformType       String
  name               String
  slug               String
  description        String?
  isEnabled          Boolean  @default(true)
  warningEnabled     Boolean  @default(false)
  warningTitle       String   @default("BEFORE YOU CONTINUE")
  warningMessage     String   @default("For new or beta software, test it first in a non-critical environment or secondary profile before using it with important accounts or data. Follow the provided setup instructions carefully.")
  warningButtonText  String   @default("I UNDERSTAND — CONTINUE")
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customers Customer[]
  resources PackageResource[]
  packages  Package[]

  @@unique([platformType, slug])
  // Branch lookup is always "this platform, ordered by sortOrder".
  @@index([platformType, isEnabled, sortOrder])
  @@index([platformType, sortOrder])
}

model Agent {
  id               String     @id @default(uuid())
  username         String     @unique
  passwordHash     String
  role             String     @default("AGENT")
  status           String     @default("ACTIVE")
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdCustomers Customer[]
}

model Package {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  platformType       String            @default("ANDROID")
  branchId           String?
  isDefaultForAgents Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  customers          Customer[]
  resources          PackageResource[]
  branch             PlatformBranch?   @relation(fields: [branchId], references: [id])

  @@index([platformType, isDefaultForAgents])
  @@index([branchId])
}

model PackageResource {
  id           String   @id @default(uuid())
  packageId    String?
  platformType String   @default("ANDROID")
  branchId     String?
  type         String
  name         String
  description  String?
  url          String?
  secret       String?
  version      String?
  status       String   @default("active")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  package      Package? @relation(fields: [packageId], references: [id])
  branch       PlatformBranch? @relation(fields: [branchId], references: [id])

  // The customer dashboard resolves resources by package OR by platform-wide.
  @@index([branchId])
  @@index([packageId])
  @@index([platformType, status, sortOrder])
  @@index([platformType, packageId, status])
}

model CustomerDevice {
  id              String   @id @default(uuid())
  customerId      String
  deviceTokenHash String   @unique
  fingerprint     String?
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String   @id @default(uuid())
  slug               String   @unique
  name               String
  description        String?
  price              Float
  active             Boolean  @default(true)
  coverImageUrl      String?
  demoVideoUrl       String?
  demoVideoType      String?  @default("DIRECT")
  demoVideoPosterUrl String?
  videoAutoplay      Boolean  @default(true)
  videoMutedDefault  Boolean  @default(true)
  videoLoop          Boolean  @default(false)
  videoEnabled       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]

  @@index([active, createdAt(sort: Desc)])
}

model Order {
  id               String   @id @default(uuid())
  orderNumber      String   @unique
  productId        String
  priceSnapshot    Float
  customerEmail    String
  customerDiscord  String?
  paymentProofPath String?
  amountReported   Float?
  amountMatches    Boolean?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([productId])
}

model PaymentMethod {
  id             String   @id @default(uuid())
  name           String
  accountDetails String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(uuid())
  title     String?
  message   String
  link      String?
  type      String    @default("INFO")
  scope     String    @default("ALL")
  active    Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Popup {
  id         String    @id @default(uuid())
  title      String
  message    String
  imageUrl   String?
  buttonText String?
  buttonLink String?
  scope      String    @default("ALL")
  frequency  String    @default("ONCE_PER_SESSION")
  active     Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Owner-configured promotion: MK FREE PC PANEL (5-day trial claim system).
/// Stored as a single SiteSetting KV row (JSON) — no schema changes needed for copy tweaks.
/// FreeClaim rows track individual visitor claims; keys are issued server-side only.
model FreeClaim {
  id           String        @id @default(uuid())
  /// Random opaque token identifying this claim in the visitor's session.
  claimToken   String        @unique
  /// Server-generated access key (plaintext, same storage pattern as PackageResource.secret)
  key          String        @unique
  platform     String        @default("PC")
  durationDays Int           @default(5)
  /// Steps completed at claim time, e.g. "whatsapp,youtube,discord"
  stepsDone    String        @default("")
  status       String        @default("ACTIVE")
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  panelKey     FreePanelKey?
}

/// ──────────────────────────────────────────────────────────────────────
/// FIRST-PARTY WEBSITE ANALYTICS
/// Anonymous, cookie-scoped visitor identity → sessions → events.
/// No personal data, no fingerprints, no form contents, no full IP.
/// ──────────────────────────────────────────────────────────────────────

/// Anonymous visitor. `anonymousId` is a random first-party token issued by
/// the browser (UUID). It is never derived from IP/device/hardware traits.
model AnalyticsVisitor {
  id             String   @id @default(uuid())
  anonymousId    String   @unique @map("anonymous_visitor_id")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  firstReferrer  String?  @map("first_referrer")
  lastReferrer   String?  @map("last_referrer")
  deviceCategory String   @default("unknown") @map("device_category")
  deviceName     String?  @map("device_name")
  osName         String?  @map("os_name")
  browserName    String?  @map("browser_name")
  isBot          Boolean  @default(false) @map("is_bot")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions AnalyticsSession[]
  events   AnalyticsEvent[]

  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@map("analytics_visitors")
}

/// A visit. A new session starts after ~30 minutes of inactivity.
/// `currentSection` holds the last meaningfully visible section key.
model AnalyticsSession {
  id             String    @id @default(uuid())
  sessionKey     String    @unique @map("session_id")
  visitorId      String    @map("visitor_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  endedAt        DateTime? @map("ended_at")
  pageViewCount  Int       @default(0) @map("page_view_count")
  entryPath      String    @map("entry_path")
  lastPath       String    @map("last_path")
  currentSection String?   @map("current_section")
  deviceCategory String    @default("unknown") @map("device_category")
  deviceName     String?   @map("device_name")
  osName         String?   @map("os_name")
  browserName    String?   @map("browser_name")
  referrer       String?   @map("referrer")
  isBot          Boolean   @default(false) @map("is_bot")
  createdAt      DateTime  @default(now()) @map("created_at")

  visitor AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events  AnalyticsEvent[]

  @@index([lastSeenAt])
  @@index([startedAt])
  @@index([visitorId])
  @@map("analytics_sessions")
}

/// Controlled event log — only three event types are ever written:
/// page_view | section_view | important_click.
model AnalyticsEvent {
  id         String   @id @default(uuid())
  visitorId  String   @map("visitor_id")
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type")
  pagePath   String   @map("page_path")
  sectionKey String?  @map("section_key")
  targetKey  String?  @map("target_key")
  createdAt  DateTime @default(now()) @map("created_at")

  visitor AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([pagePath])
  @@index([visitorId])
  @@index([sessionId])
  @@map("analytics_events")
}

/// Owner-imported Free Panel key inventory. Assignment is atomic via a
/// transactional updateMany on an AVAILABLE row — two concurrent claims can
/// never receive the same key.
model FreePanelKey {
  id         String     @id @default(uuid())
  keyValue   String     @unique
  status     String     @default("AVAILABLE") // AVAILABLE | ASSIGNED | DISABLED
  batchId    String?
  notes      String?
  claimId    String?    @unique
  assignedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  claim      FreeClaim? @relation(fields: [claimId], references: [id])

  @@index([status])
  @@index([claimId])
}
